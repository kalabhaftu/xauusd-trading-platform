# Local secrets only. Never paste passwords into CLI arguments or commit .env.
XAU_MODE=DEMO
XAU_DATABASE_URL=sqlite:///data/platform.db
XAU_MT5_PATH=
XAU_ACCOUNT_LOGIN=
XAU_ACCOUNT_SERVER=
XAU_EXPECTED_COMPANY=Exness
XAU_ACCOUNT_PASSWORD=
XAU_SYMBOL=
XAU_SESSION_FILE=
XAU_ACTIVE_STRATEGY=trend_pullback
XAU_ENTRIES_ARMED=false
# Conservative starter tolerances, not assertions about broker spreads or fills.
# Spread/slippage price fields use gold quote price units; deviation uses actual broker points.
XAU_MAX_SPREAD=0.50
XAU_MAX_SLIPPAGE_POINTS=20
XAU_SLIPPAGE_PRICE=0.20
XAU_RISK_PER_TRADE=0.0025
XAU_HARD_RISK_MAX=0.005
XAU_DAILY_LOSS_LIMIT=0.01
XAU_WEEKLY_LOSS_LIMIT=0.03
XAU_DRAWDOWN_LIMIT=0.10
XAU_PORTFOLIO_RISK_LIMIT=0.005
XAU_MAX_ORDERS_SESSION=3
XAU_CONSECUTIVE_LOSS_LIMIT=3
XAU_LOSS_COOLDOWN_MINUTES=60
XAU_EMERGENCY_CLOSE_ATTEMPTS=3
XAU_POLL_SECONDS=5
XAU_QUOTE_MAX_AGE_SECONDS=10
# Required broker-specific costs: explicit zero is valid if verified for this account.
XAU_COMMISSION_PER_LOT=
XAU_SWAP_LONG_PER_LOT_DAY=
XAU_SWAP_SHORT_PER_LOT_DAY=
XAU_TELEGRAM_TOKEN=
XAU_TELEGRAM_CHAT_ID=
