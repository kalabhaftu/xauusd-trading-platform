# Developer-only defaults. End users configure accounts inside the Aurum app.
# Log in to MT5 on the terminal itself; never put your broker password here.
XAU_MODE=DEMO
XAU_EXPECTED_COMPANY=Exness
XAU_ACTIVE_STRATEGY=ict_sweep_mss_fvg
XAU_COST_MODE=AUTO

# Optional local account details for developers running the source directly.
XAU_ACCOUNT_LOGIN=
XAU_ACCOUNT_SERVER=
XAU_SYMBOL=
XAU_MT5_PATH=

# Optional Telegram notifications. Configure in the app when possible.
XAU_TELEGRAM_TOKEN=
XAU_TELEGRAM_CHAT_ID=
